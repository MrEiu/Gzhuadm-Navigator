PORT=3001
# Use one stable random value for password hashing across registration and login.
AUTH_PASSWORD_SALT=replace-with-a-long-random-secret
# Optional: model id selected by default in the client.
DEFAULT_MODEL=deepseek-chat
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
OPENAI_API_KEY=
# Optional JSON array. It overrides the built-in model registry.
# MODEL_CONFIG_JSON=[{"id":"deepseek-chat","name":"DeepSeek Chat","provider":"deepseek","endpoint":"https://api.deepseek.com/chat/completions","apiKeyEnv":"DEEPSEEK_API_KEY","supportsVision":false,"temperature":0.7,"maxTokens":4096}]
# Optional OpenAI-compatible web search endpoint. Use {query} as the URL placeholder.
# WEB_SEARCH_URL=
# WEB_SEARCH_API_KEY=
PUBLIC_BASE_URL=http://localhost:3001
