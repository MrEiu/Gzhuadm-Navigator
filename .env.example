# ==============================================================================
# Gzadm Navigator · 系统环境配置模板 (.env.example)
# 使用说明：复制此文件为 .env 并填入您的 API 密钥与相关服务配置
# 亦可直接运行命令：npm run init (或 node bin/gzhu.mjs init) 启动交互式配置向导
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. 基础服务端口与网关配置
# ------------------------------------------------------------------------------
PORT=3001

# ------------------------------------------------------------------------------
# 2. 大语言模型 (LLM) 网关与双模型协同配置
# ------------------------------------------------------------------------------
# 主模型 (DEFAULT_MODEL): 负责复杂的招生多轮对话与志愿建议推理
AI_BASE_URL=https://api.deepseek.com
AI_API_KEY=your_deepseek_or_openai_api_key_here
DEFAULT_MODEL=deepseek-chat
DEFAULT_MODEL_PROVIDER=DeepSeek (深度求索)

# 快速模型 (FAST_MODEL): 负责文档切片、实体提取与轻量意图分类 (可与主模型共用同一端点)
FAST_AI_BASE_URL=https://api.deepseek.com
FAST_AI_API_KEY=your_fast_model_api_key_here
FAST_MODEL=deepseek-chat
FAST_MODEL_PROVIDER=DeepSeek (深度求索)

# ------------------------------------------------------------------------------
# 3. 校园伴游语音合成 (TTS Engine) 方案配置
# 引擎模式可选: msedge (方案1·推荐) | onnx (方案2·离线) | api (方案4·云端)
# ------------------------------------------------------------------------------
TTS_ENGINE=msedge

# 方案 1: 微软 Edge Neural 神经网络语音 (免Key · 活泼女大学生音色)
# 可选音色: zh-CN-XiaoyiNeural (推荐) | zh-CN-XiaoxiaoNeural | zh-CN-liaoning-XiaobeiNeural | zh-HK-HiuGaaiNeural | zh-CN-YunxiNeural
MSEDGE_VOICE=zh-CN-XiaoyiNeural

# 方案 2: 本地轻量 ONNX 离线推理模型
ONNX_TTS_MODEL_PATH=data/models/tts_vits_zh.onnx
ONNX_TTS_SPEED=1.0

# 方案 4: 自定义 Cloud TTS API (OpenAI 协议兼容)
TTS_API_URL=https://api.openai.com/v1
TTS_API_KEY=
TTS_API_MODEL=tts-1
TTS_API_VOICE=nova

# ------------------------------------------------------------------------------
# 4. 招生实时联网搜索引擎 (Web Search Provider)
# 选项: multi (推荐·多源容灾) | bing (必应直连) | tavily | bocha (博查) | none
# ------------------------------------------------------------------------------
SEARCH_PROVIDER=multi
TAVILY_API_KEY=
BOCHA_API_KEY=

# ------------------------------------------------------------------------------
# 5. 考生注册登录方式 (三选一单选)
# 选项: username (普通账号密码) | phone (腾讯云短信验证码) | email (SMTP邮箱验证码)
# ------------------------------------------------------------------------------
AUTH_REGISTRATION_MODE=username
ADVANCED_AUTH_ENABLED=false

# 手机短信注册通道 (腾讯云 SMS)
TENCENT_SMS_SECRET_ID=
TENCENT_SMS_SECRET_KEY=
TENCENT_SMS_SDK_APP_ID=
TENCENT_SMS_SIGN_NAME=
TENCENT_SMS_TEMPLATE_ID=

# 邮箱验证码直发通道 (SMTP 协议)
SMTP_HOST=smtp.qq.com
SMTP_PORT=587
SMTP_SECURE_ENABLED=0
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
MAIL_FROM_NAME=Gzadm-Navigator
